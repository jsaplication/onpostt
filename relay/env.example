# ============================================================
# onpostt relay — configuração de ambiente
# Copie para .env e ajuste. NUNCA versione o .env.
# ============================================================

# Ambiente: development | production | test
NODE_ENV=development

# ---- Servidor HTTP ----
PORT_HTTP=3000
# 0.0.0.0 escuta em todas as interfaces; use 127.0.0.1 atrás de proxy local
HOST=0.0.0.0

# Origens permitidas para CORS/WebSocket (separadas por vírgula, sem espaços).
# A mesma origem do próprio servidor é sempre permitida automaticamente.
# Use * somente em desenvolvimento consciente.
HOST_ALLOWED=http://localhost:3000,http://127.0.0.1:3000

# Aceitar WebSocket sem cabeçalho Origin (clientes nativos/CLI). Padrão: false.
ALLOW_NO_ORIGIN=false

# Confiar em X-Forwarded-* (true/false ou número de proxies). Use true atrás de Nginx.
TRUST_PROXY=false

# Timeouts do servidor HTTP (ms)
HTTP_HEADERS_TIMEOUT=20000
HTTP_REQUEST_TIMEOUT=30000
HTTP_KEEP_ALIVE_TIMEOUT=5000

# ---- Limites HTTP ----
# Requisições simultâneas em processamento
HTTP_MAX_CONNECTIONS=2000
# Tamanho máximo do corpo JSON (bytes) - 2 MB
HTTP_MAX_MESSAGE_SIZE=2097152

# ---- Limites WebSocket ----
SOCKET_PATH=/
SOCKET_MAX_CONNECTIONS=1000
SOCKET_MAX_MESSAGE_SIZE=1048576
# Tempo máximo sem atividade antes de encerrar a conexão (ms)
SOCKET_INACTIVITY_TIMEOUT=600000
# Intervalo do ping/pong do servidor (ms)
SOCKET_HEARTBEAT_INTERVAL=30000
SOCKET_MAX_SUBSCRIPTIONS=25
SOCKET_MAX_PUBKEYS=5

# ---- Limites do protocolo ----
MAX_BLOCKS_PER_REQUEST=1000
# Teto aproximado de bytes por resposta de listagem/assinatura. Quando excedido,
# a resposta volta com "truncated": true e pode ser paginada com offset.
MAX_RESPONSE_BYTES=8388608
# Mensagens cifradas geram dois envelopes; o conteúdo precisa comportar imagem
# ou áudio de até 15s em base64. O WebSocket mantém 1 MB por mensagem.
MAX_BLOCK_SIZE=2097152
MAX_CONTENT_SIZE=1048576

# Imagens em posts: JPEG/PNG, dimensões reais lidas pelo relay.
# O demo reduz no navegador para no máximo 500px e mira 64 KB; o relay aceita
# até 72 KB decodificados e 128 KB de JSON de conteúdo.
MAX_IMAGE_BYTES=73728
MAX_IMAGE_DIMENSION=500
MAX_IMAGE_CONTENT_SIZE=131072

MAX_QUERY_PAIRS=32
MAX_QUERY_KEY_LENGTH=64
MAX_QUERY_VALUE_LENGTH=2048
MAX_APP_LENGTH=190
MAX_FUTURE_SKEW_SECONDS=600
# Validade do token de leitura assinado (`reader`) em segundos. Padrão: 30 dias.
READER_TOKEN_TTL_SECONDS=2592000

# Verifica se o id do bloco é sha256 do conteúdo (recomendado: true)
VALIDATE_BLOCK_ID=true

# ---- Rate limit (em memória, por IP) ----
# O cliente atualiza o estado com ~10 leituras após cada ação social.
# Read 1200/min e write 300/min atendem uso interativo sem 429 frequente.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_READ=1200
RATE_LIMIT_MAX_WRITE=300
RATE_LIMIT_MAX_WS=600

# ---- PostgreSQL ----
# Prefira DATABASE_URL; se ausente, usa as variáveis PG* abaixo.
# DATABASE_URL=postgres://postgres:senha@localhost:5432/onpostt
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=troque-esta-senha
PGDATABASE=onpostt

# Pool
MAX_POOL_SIZE=20
DB_CONNECTION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000

# TLS do banco: true/false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Logs ----
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=logs

# Encerrar o processo em exceção não capturada (recomendado em produção: true)
EXIT_ON_UNCAUGHT=false

# HSTS — habilite apenas quando servir HTTPS
ENABLE_HSTS=false

# Identidade do relay exibida na página inicial (opcional)
RELAY_NAME=onpostt relay
